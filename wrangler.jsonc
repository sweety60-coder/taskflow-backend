{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "taskflow-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taskflow-db",
      "database_id": "a9679bb9-88e8-4693-a481-dc2058444af2"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "975315",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "taskflow-pro-x-11703",
    "RESEND_FROM_EMAIL": "onboarding@resend.dev"
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "fa9a16d8-05e0-4387-b5e5-d064f794d793"
      }
    ],
    "ratelimits": [
      {
        "name": "AUTH_LIMITER",
        "namespace_id": "975316",
        "simple": {
          "limit": 10,
          "period": 60
        }
      }
    ],
    "vars": {
      "FIREBASE_PROJECT_ID": "taskflow-x-preview",
      "RESEND_FROM_EMAIL": "onboarding@resend.dev"
    }
  }
}
